NODE_ENV=development
PORT=5000

# Supabase Postgres URLs
# DATABASE_URL = Connection pooler (port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_platform?schema=public"
# DIRECT_URL = Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/wedding_platform?schema=public"

# Auth & Security
JWT_ACCESS_SECRET="super-secret-access-token-key-min-16-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-min-16-chars"
OTP_HMAC_SECRET="super-secret-otp-hmac-key-min-16-chars"

# Frontend Origin
FRONTEND_URL="http://localhost:5173"

# Brevo (Sendinblue) Transactional Email
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="invitations@weddingplatform.lk"
BREVO_SENDER_NAME="Wedding Invitations"

# Cloudinary (Authenticated Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
